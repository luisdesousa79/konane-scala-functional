<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Janela de configurações antes do jogo -->
<VBox spacing="15" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MainMenuController" style="-fx-padding: 30; -fx-background-color: #2b2b2b;">

    <!-- Label que vai representar o "Título" -->
    <Label text="KONANE" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>

    <Label text="CONFIGURAÇÕES DO JOGO" style="-fx-font-size: 18px; -fx-text-fill: lightgray;"/>

    <!-- Combo Box onde iremos poder escolher os vários modos de jogo-->
    <Label text="Modo de Jogo:" style="-fx-text-fill: white;"/>
    <ComboBox fx:id="modoCombo" prefWidth="250" style="-fx-background-color: #555; -fx-text-fill: white;"/>

    <!-- Combo Box onde iremos escolher a Dificuldade: Fácil, Médio, Difícil -->
    <Label text="Dificuldade:" style="-fx-text-fill: white;"/>
    <ComboBox fx:id="dificuldadeCombo" prefWidth="250" style="-fx-background-color: #555; -fx-text-fill: white;"/>

    <!-- Combo box de escolha de Tempo de jogada -->
    <Label text="Tempo por jogada:" style="-fx-text-fill: white;"/>
    <ComboBox fx:id="timerCombo" prefWidth="250" style="-fx-background-color: #555; -fx-text-fill: white;"/>

    <!-- Botão que abre a janela do jogo -->
    <Button fx:id="iniciarBtn" text="INICIAR JOGO" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" onAction="#iniciarJogo"  prefWidth="200"/>

</VBox>