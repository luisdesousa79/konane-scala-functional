<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="450.0" prefWidth="450.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller"
            style="-fx-background-color: #2b2b2b;">

    <GridPane fx:id="boardGrid"
              layoutX="25.0" layoutY="25.0"
              hgap="5" vgap="5"/>

    <Label fx:id="infoLabel"
           layoutX="25.0" layoutY="400.0"
           prefWidth="400.0"
           text="Clique numa posicao"
           style="-fx-font-size: 14px; -fx-text-fill: lightgray;"/>

</AnchorPane>